# Copy this file to .env and fill in real values. .env is git-ignored --
# never commit actual credentials.

# "offline" runs with the deterministic fixture extractor, no network call,
# no API key required. "live" calls the configured LLM provider below.
APP_MODE=offline

# --- LLM provider -----------------------------------------------------------
# Groq exposes an OpenAI-compatible chat completions API. Get a free key at
# https://console.groq.com/keys. Model names are configurable here -- check
# https://console.groq.com/docs/models for the current list, since hosted
# model availability changes over time.
LLM_PROVIDER=groq
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- CORS (frontend origins allowed to call this API) -----------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Upload limits ------------------------------------------------------------
MAX_IMAGE_SIZE_BYTES=8388608
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp

# --- Inventory matching -------------------------------------------------------
MATCH_AUTO_SELECT_THRESHOLD=0.72
MATCH_TOP_N=3

# --- Confidence / review -------------------------------------------------------
CV_VS_BRIEF_DISAGREEMENT_RATIO=0.4

# --- Server ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Leave empty for local/Docker (app reached with no prefix). Set to "/api"
# only when deploying behind a reverse proxy that strips that prefix
# (e.g. the Vercel Services deployment's /api/* routing) -- otherwise
# FastAPI's auto-generated Swagger UI references an unprefixed
# /openapi.json that 404s or resolves to the wrong service externally.
ROOT_PATH=
